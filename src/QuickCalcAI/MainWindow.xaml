<Window x:Class="QuickCalcAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        Title="QuickCalcAI"
        Width="680"
        Height="460"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#FF202020"
        Topmost="True"
        Visibility="Hidden"
        ShowActivated="False"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown"
        FontFamily="{StaticResource FluentText}">

    <!-- Full-bleed shell; DWM handles Win11 rounded corners (no fake shadow box) -->
    <Border x:Name="ShellBorder"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Background="{StaticResource SmokeFill}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Primary query field (PowerToys / Win+S style) -->
            <Border Grid.Row="0"
                    Margin="12,12,12,0"
                    Style="{StaticResource FluentFieldBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               FontFamily="{StaticResource FluentIcons}"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondary}"
                               Text="&#xE8EF;"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <Border Grid.Column="1"
                            Width="2"
                            Height="18"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentFill}"
                            CornerRadius="1"
                            Margin="0,0,12,0"
                            Opacity="0.9" />

                    <TextBox x:Name="EquationBox"
                             Grid.Column="2"
                             Style="{StaticResource FluentInput}"
                             FontSize="18"
                             FontWeight="Normal"
                             TextChanged="EquationBox_TextChanged"
                             KeyDown="EquationBox_KeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Grid>
                                    <TextBlock x:Name="Placeholder"
                                               Text="Type an equation or ask a math question"
                                               FontFamily="{StaticResource FluentText}"
                                               FontSize="18"
                                               Foreground="{StaticResource TextTertiary}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Text" Value="" />
                                            <Condition Property="IsKeyboardFocused" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Result surface -->
            <Border Grid.Row="1"
                    Margin="12,10,12,8"
                    Background="{StaticResource SubtleFill}"
                    CornerRadius="{StaticResource ControlCorner}"
                    BorderBrush="{StaticResource CardStroke}"
                    BorderThickness="1"
                    MinHeight="168"
                    Padding="18,14">
                <Grid>
                    <!-- Number answer -->
                    <StackPanel x:Name="NumberPanel"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiary}"
                                   Text="Result"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="ResultText"
                                   FontFamily="{StaticResource FluentDisplay}"
                                   FontSize="42"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SecondaryResultText"
                                   FontFamily="{StaticResource FluentText}"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Explanation -->
                    <ScrollViewer x:Name="ExplainScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed"
                                  Padding="0,0,4,0">
                        <StackPanel>
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiary}"
                                       Text="Explanation"
                                       Margin="0,0,0,8" />
                            <TextBlock x:Name="ExplainBlock"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <Image x:Name="BusySpinner"
                           Width="28"
                           Height="28"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           gif:ImageBehavior.AnimatedSource="/Assets/ios_activity_indicator.gif"
                           gif:ImageBehavior.AutoStart="True"
                           gif:ImageBehavior.RepeatBehavior="Forever" />

                    <!-- Idle hint -->
                    <TextBlock x:Name="IdleHint"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextDisabled}"
                               Text="Answer shows up here"
                               TextAlignment="Center" />
                </Grid>
            </Border>

            <!-- Follow-up -->
            <Border x:Name="FollowUpPanel"
                    Grid.Row="2"
                    Margin="12,0,12,8"
                    Style="{StaticResource FluentFieldBorder}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               FontFamily="{StaticResource FluentIcons}"
                               FontSize="14"
                               Foreground="{StaticResource TextTertiary}"
                               Text="&#xE8BD;"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <TextBox x:Name="FollowUpBox"
                             Grid.Column="1"
                             Style="{StaticResource FluentInput}"
                             FontSize="14"
                             KeyDown="FollowUpBox_KeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Grid>
                                    <TextBlock x:Name="FollowPlaceholder"
                                               Text="Ask a follow-up"
                                               FontFamily="{StaticResource FluentText}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextTertiary}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Text" Value="" />
                                            <Condition Property="IsKeyboardFocused" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="FollowPlaceholder" Property="Visibility" Value="Visible" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <Border Grid.Column="2"
                            Margin="10,0,0,0"
                            Padding="8,3"
                            Background="{StaticResource CardFill}"
                            BorderBrush="{StaticResource CardStroke}"
                            BorderThickness="1"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource TextTertiary}"
                                   Text="Enter" />
                    </Border>
                </Grid>
            </Border>

            <!-- Fluent command-bar footer -->
            <Border Grid.Row="3"
                    Padding="16,8,16,10"
                    BorderBrush="{StaticResource Divider}"
                    BorderThickness="0,1,0,0"
                    Background="#08000000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource FluentIcons}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextTertiary}"
                                   Text="&#xE8EF;"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="FooterLabel"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="Calculator"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource TextDisabled}"
                                   Text="Ctrl+C copy"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource TextDisabled}"
                                   Text="Ctrl+Space"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource TextDisabled}"
                                   Text="Esc"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
