<Application x:Class="NockAI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Fluent / Win11 dark tokens -->
            <FontFamily x:Key="FluentText">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="FluentDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="FluentIcons">Segoe Fluent Icons</FontFamily>

            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="TextTertiary" Color="#87FFFFFF" />
            <SolidColorBrush x:Key="TextDisabled" Color="#5DFFFFFF" />

            <!-- Layer / smoke fills -->
            <SolidColorBrush x:Key="SmokeFill" Color="#CC202020" />
            <SolidColorBrush x:Key="CardFill" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="CardFillHover" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="CardStroke" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="Divider" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="FocusStroke" Color="#60CDFF" />
            <SolidColorBrush x:Key="AccentFill" Color="#60CDFF" />
            <SolidColorBrush x:Key="AccentBar" Color="#60CDFF" />
            <SolidColorBrush x:Key="SubtleFill" Color="#0AFFFFFF" />

            <!-- Shared corner radius -->
            <CornerRadius x:Key="ControlCorner">8</CornerRadius>
            <CornerRadius x:Key="OverlayCorner">12</CornerRadius>

            <Style x:Key="FluentFieldBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCorner}" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource FocusStroke}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Padding" Value="13,9" />
                        <Setter Property="Background" Value="{StaticResource CardFillHover}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FluentInput" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource FluentText}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
