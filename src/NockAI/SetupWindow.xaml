<Window x:Class="NockAI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NockAI setup"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="520"
        Height="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="{StaticResource FluentText}"
        Topmost="True"
        SourceInitialized="Window_SourceInitialized">
    <Border BorderBrush="#28FFFFFF"
            BorderThickness="1"
            Background="{StaticResource SmokeFill}"
            CornerRadius="{StaticResource OverlayCorner}"
            Padding="28,24"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock FontFamily="{StaticResource FluentIcons}"
                           FontSize="22"
                           Foreground="{StaticResource AccentFill}"
                           Text="&#xE8EF;"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock Text="NockAI"
                           FontFamily="{StaticResource FluentDisplay}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="14"
                       Margin="0,0,0,20"
                       Text="Paste a free Groq API key to unlock natural-language math. Symbolic math still works offline." />

            <TextBlock Grid.Row="2"
                       Style="{StaticResource CaptionLabel}"
                       Text="Groq API key"
                       Margin="0,0,0,8" />

            <Border Grid.Row="3" Style="{StaticResource FluentFieldBorder}" Padding="12,8">
                <TextBox x:Name="KeyBox"
                         Style="{StaticResource FluentInput}"
                         FontSize="14" />
            </Border>

            <TextBlock Grid.Row="4"
                       VerticalAlignment="Top"
                       Margin="0,14,0,0"
                       FontSize="12"
                       Foreground="{StaticResource TextTertiary}"
                       TextWrapping="Wrap">
                <Hyperlink NavigateUri="https://console.groq.com/keys"
                           RequestNavigate="Link_RequestNavigate"
                           Foreground="{StaticResource AccentFill}">
                    Get a free key at console.groq.com/keys
                </Hyperlink>
            </TextBlock>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="Quit"
                        Width="96"
                        Height="32"
                        Margin="0,0,8,0"
                        Style="{StaticResource FluentQuietButton}"
                        Click="Quit_Click" />
                <Button Content="Save &amp; start"
                        Width="128"
                        Height="32"
                        Style="{StaticResource FluentAccentButton}"
                        IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
