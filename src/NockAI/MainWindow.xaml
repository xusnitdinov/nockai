<Window x:Class="NockAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NockAI"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="700"
        Height="448"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="True"
        Visibility="Hidden"
        ShowActivated="False"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown"
        FontFamily="{StaticResource FluentText}">

    <!-- Transparent client so DWM acrylic/mica paints through; shell tints on top -->
    <Border x:Name="ShellBorder"
            BorderBrush="#28FFFFFF"
            BorderThickness="1"
            Background="{StaticResource SmokeFill}"
            CornerRadius="{StaticResource OverlayCorner}"
            SnapsToDevicePixels="True"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Primary query - Win+S / PowerToys Run -->
            <Border Grid.Row="0"
                    Margin="14,14,14,0"
                    Style="{StaticResource FluentFieldBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               FontFamily="{StaticResource FluentIcons}"
                               FontSize="16"
                               Foreground="{StaticResource TextSecondary}"
                               Text="&#xE721;"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Opacity="0.95" />

                    <TextBox x:Name="EquationBox"
                             Grid.Column="1"
                             Style="{StaticResource FluentInput}"
                             FontSize="18"
                             FontWeight="Normal"
                             TextChanged="EquationBox_TextChanged"
                             KeyDown="EquationBox_KeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Grid>
                                    <TextBlock x:Name="Placeholder"
                                               Text="Type an equation or ask a math question"
                                               FontFamily="{StaticResource FluentText}"
                                               FontSize="18"
                                               Foreground="{StaticResource TextTertiary}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Text" Value="" />
                                            <Condition Property="IsKeyboardFocused" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Result surface -->
            <Border Grid.Row="1"
                    Margin="14,10,14,8"
                    Background="{StaticResource SubtleFill}"
                    CornerRadius="{StaticResource FieldCorner}"
                    BorderBrush="{StaticResource CardStroke}"
                    BorderThickness="1"
                    MinHeight="160"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Fluent indeterminate bar (replaces iOS spinner) -->
                    <ProgressBar x:Name="BusyBar"
                                 Grid.Row="0"
                                 Height="3"
                                 Margin="1,1,1,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource AccentFill}"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed" />

                    <Grid Grid.Row="1" Margin="18,14">
                        <!-- Number answer -->
                        <StackPanel x:Name="NumberPanel"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CaptionLabel}"
                                       Text="Result"
                                       Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ResultIcon"
                                           FontFamily="{StaticResource FluentIcons}"
                                           FontSize="28"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="ResultText"
                                           FontFamily="{StaticResource FluentDisplay}"
                                           FontSize="36"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="SecondaryResultText"
                                       FontFamily="{StaticResource FluentText}"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,8,0,0"
                                       Visibility="Collapsed"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Explanation -->
                        <ScrollViewer x:Name="ExplainScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed"
                                      Padding="0,0,2,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CaptionLabel}"
                                           Text="Explanation"
                                           Margin="0,0,0,10" />
                                <TextBlock x:Name="ExplainBlock"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Idle hint -->
                        <TextBlock x:Name="IdleHint"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource TextDisabled}"
                                   Text="Answer shows up here"
                                   TextAlignment="Center" />

                        <!-- Busy: Thinking... with timer-driven L→R shine -->
                        <TextBlock x:Name="ThinkingLabel"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource FluentText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Thinking..."
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False">
                            <TextBlock.Foreground>
                                <LinearGradientBrush x:Name="ThinkBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#48FFFFFF" Offset="0" />
                                    <GradientStop x:Name="ThinkEdgeL" Color="#48FFFFFF" Offset="0" />
                                    <GradientStop x:Name="ThinkHot" Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop x:Name="ThinkEdgeR" Color="#48FFFFFF" Offset="0" />
                                    <GradientStop Color="#48FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- Follow-up -->
            <Border x:Name="FollowUpPanel"
                    Grid.Row="2"
                    Margin="14,0,14,8"
                    Style="{StaticResource FluentFieldBorder}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               FontFamily="{StaticResource FluentIcons}"
                               FontSize="14"
                               Foreground="{StaticResource TextTertiary}"
                               Text="&#xE8BD;"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <TextBox x:Name="FollowUpBox"
                             Grid.Column="1"
                             Style="{StaticResource FluentInput}"
                             FontSize="14"
                             KeyDown="FollowUpBox_KeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Grid>
                                    <TextBlock x:Name="FollowPlaceholder"
                                               Text="Ask a follow-up"
                                               FontFamily="{StaticResource FluentText}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextTertiary}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Text" Value="" />
                                            <Condition Property="IsKeyboardFocused" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="FollowPlaceholder" Property="Visibility" Value="Visible" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <Border Grid.Column="2"
                            Style="{StaticResource KeyVisual}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource KeyVisualLabel}" Text="Enter" />
                    </Border>
                </Grid>
            </Border>

            <!-- Command bar -->
            <Border Grid.Row="3"
                    Padding="16,9,12,11"
                    BorderBrush="{StaticResource Divider}"
                    BorderThickness="0,1,0,0"
                    Background="#0A000000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource FluentIcons}"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentFill}"
                                   Text="&#xE8EF;"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="FooterLabel"
                                   FontSize="12"
                                   FontFamily="{StaticResource FluentSmall}"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="Calculator"
                                   VerticalAlignment="Center" />
                        <Border x:Name="SendModeChip"
                                Style="{StaticResource KeyVisual}"
                                Margin="12,0,0,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="Settings_Click"
                                ToolTip="Open settings">
                            <TextBlock x:Name="SendModeLabel"
                                       Style="{StaticResource KeyVisualLabel}"
                                       Text="Auto" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Padding="6,2"
                                Margin="0,0,8,0"
                                ToolTip="Settings"
                                MouseLeftButtonUp="Settings_Click">
                            <TextBlock FontFamily="{StaticResource FluentIcons}"
                                       FontSize="14"
                                       Foreground="{StaticResource TextTertiary}"
                                       Text="&#xE713;"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource KeyVisual}">
                            <TextBlock Style="{StaticResource KeyVisualLabel}" Text="Ctrl+C" />
                        </Border>
                        <Border Style="{StaticResource KeyVisual}">
                            <TextBlock Style="{StaticResource KeyVisualLabel}" Text="Ctrl+Space" />
                        </Border>
                        <Border Style="{StaticResource KeyVisual}" Margin="0">
                            <TextBlock Style="{StaticResource KeyVisualLabel}" Text="Esc" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
